# ===== Environment Variables for Stock Analytics =====
# Copy this file to .env.local and fill in your values
# .env.local is gitignored and will NOT be committed

# Google OAuth2 (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OpenAI API Key (from platform.openai.com)
OPENAI_API_KEY=sk-your-openai-api-key

# Database (PostgreSQL) - defaults work for local
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tokendb
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres

# Google Service Account (for Google Sheets integration)
# GOOGLE_SA_CREDENTIALS_FILE=file:/path/to/credentials.json
